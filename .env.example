# Image source
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=yantianqi1
IMAGE_TAG=latest

# Exposed ports
PUBLIC_HTTP_PORT=7700
ADMIN_HTTP_PORT=7701

# Runtime
APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=api

# Database
POSTGRES_DB=commercial_studio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/commercial_studio

# Public origins
PUBLIC_WEB_ORIGIN=http://localhost:7700
ADMIN_WEB_ORIGIN=http://localhost:7701
API_BASE_URL=http://localhost:7800

# Sessions
USER_SESSION_COOKIE_NAME=studio_user_session
ANONYMOUS_SESSION_COOKIE_NAME=studio_anonymous_session
ANONYMOUS_SESSION_COOKIE_SECURE=false
ANONYMOUS_SESSION_MAX_AGE_SECONDS=31536000
ADMIN_SESSION_COOKIE_NAME=studio_admin_session
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_MAX_AGE_SECONDS=2592000
SESSION_SECRET=change-me

# Auth bootstrap
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# Billing and activation codes
SIGNUP_BONUS_CENTS=100
ACTIVATION_CODE_LENGTH=32

# Generated files / asset storage
GENERATED_ASSETS_DIR=./generated-assets
ASSET_STORAGE_BACKEND=local
ASSET_STORAGE_GCS_BUCKET=
ASSET_STORAGE_GCS_PREFIX=generated-assets
GCS_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
CHAT_IMAGE_TIMEOUT_SECONDS=180
CHAT_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60

# Optional provider secrets
OPENAI_PROVIDER_KEY=
OPENAI_PROVIDER_NAME=wdapi
OPENAI_PROVIDER_TYPE=openai-chat-compatible
OPENAI_PROVIDER_BASE_URL=https://ws.wdapi.top/v1
OPENAI_PROVIDER_API_KEY_ENV=OPENAI_PROVIDER_KEY
OPENAI_PROVIDER_DEFAULT_MODEL=gemini-3-flash-preview-low
OPENAI_CHAT_MODEL_CODE=gemini-3-flash-preview-low
OPENAI_CHAT_MODEL_DISPLAY_NAME=Gemini 3 Flash Preview Low
OPENAI_CHAT_MODEL_PROVIDER_MODEL=gemini-3-flash-preview-low
OPENAI_CHAT_MODEL_MEMBER_PRICE_CENTS=12
OPENAI_CHAT_MODEL_ANONYMOUS_PRICE_CENTS=0
OPENAI_IMAGE_MODEL_CODE=gpt-image-2
OPENAI_IMAGE_MODEL_DISPLAY_NAME=GPT Image 2
OPENAI_IMAGE_MODEL_PROVIDER_MODEL=gpt-image-2
OPENAI_IMAGE_MODEL_MEMBER_PRICE_CENTS=77
OPENAI_IMAGE_MODEL_ANONYMOUS_PRICE_CENTS=0
OPENAI_OFFICIAL_API_KEY=
OPENAI_OFFICIAL_PROVIDER_NAME=openai-official
OPENAI_OFFICIAL_PROVIDER_TYPE=openai-compatible
OPENAI_OFFICIAL_PROVIDER_BASE_URL=https://api.openai.com/v1
OPENAI_OFFICIAL_PROVIDER_API_KEY_ENV=OPENAI_OFFICIAL_API_KEY
OPENAI_OFFICIAL_PROVIDER_DEFAULT_MODEL=gpt-image-2
OPENAI_OFFICIAL_IMAGE_MODEL_CODE=gpt-image-2-official
OPENAI_OFFICIAL_IMAGE_MODEL_DISPLAY_NAME=GPT Image 2 官方通道
OPENAI_OFFICIAL_IMAGE_MODEL_PROVIDER_MODEL=gpt-image-2
OPENAI_OFFICIAL_IMAGE_MODEL_MEMBER_PRICE_CENTS=130
OPENAI_OFFICIAL_IMAGE_MODEL_ANONYMOUS_PRICE_CENTS=0

# Worker
WORKER_NAME=commercial-studio-worker
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_IMAGE_JOB_CONCURRENCY=3
WORKER_STALE_RUNNING_JOB_SECONDS=300
WORKER_STALE_JOB_ALERT_THRESHOLD=1
